{
  "name": "kotoha-fansite",
  "version": "1.0.0",
  "private": true,
  "description": "Kotoha Fan Site — an unofficial, non-profit, bilingual (JA/EN) fan site for Kotoha (ことは). By Moeko Works.",
  "license": "MIT",
  "author": "Moeko Works (https://moekoworks.vercel.app)",
  "homepage": "https://kotoha-fansite.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PastelSalt/kotoha-fansite.git"
  },
  "bugs": {
    "url": "https://github.com/PastelSalt/kotoha-fansite/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx vercel dev",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "db:status": "node --env-file=.env.local scripts/migrate.js --status",
    "db:seed": "node --env-file=.env.local scripts/run-sql.js db/seed.sql",
    "admin:bootstrap": "node --env-file=.env.local scripts/admin-bootstrap.js",
    "images:optimize": "node scripts/optimize-images.js",
    "prelaunch:reset": "node --env-file=.env.local scripts/prelaunch-reset.js",
    "gallery:seed": "node --env-file=.env.local scripts/seed-gallery.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
