# Copy to .env.local and fill in real values. NEVER commit .env.local.
# In Vercel, set the same keys under Project → Settings → Environment Variables.

# --- Neon PostgreSQL ---
# Pooled connection string (runtime, used by API functions)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (unpooled) connection string (migrations, seed and admin scripts)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Cloudinary (gallery) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_FOLDER=kotoha-fansite/gallery
CLOUDINARY_UPLOAD_PRESET=kotoha_gallery_signed

# --- Analytics ---
# Long random string; used to hash visitor fingerprints (no raw IPs are stored)
ANALYTICS_SALT=replace-with-a-long-random-string

# --- Owner bootstrap (used ONCE by `npm run admin:bootstrap`, then delete) ---
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional ---
# Extra allowed origins for state-changing requests (comma-separated), e.g. a custom domain
ALLOWED_ORIGINS=
